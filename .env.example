# Copy relevant values into your shell environment before `bun run start` if you
# need to override a default. Most users can run `bun run start` with none of
# these set — it generates a token, detects your LAN IP, and prints a QR code.

# Shared secret the PWA must present to the daemon. Auto-generated and persisted
# to ~/.config/wranglr/token on first run if not set.
WRANGLR_TOKEN=

# Interface the daemon's WebSocket server binds to. Defaults to 0.0.0.0 so a
# phone on the same Wi-Fi can reach it. Use 127.0.0.1 to restrict to this
# machine only.
WRANGLR_BIND_HOST=0.0.0.0

# Interface the static PWA server binds to. Same default/behavior as above.
WRANGLR_PWA_HOST=0.0.0.0

# Hostname/IP embedded in the pairing QR code and printed phone URL. Defaults
# to an auto-detected LAN IPv4 address; set this if auto-detection picks the
# wrong network interface or you're using a hostname instead.
WRANGLR_PUBLIC_HOST=

# Set to "true" only if you've put the daemon behind your own TLS-terminating
# reverse proxy. Leave unset for plain http/ws on your local network.
WRANGLR_SECURE=

WRANGLR_WS_PORT=7420
WRANGLR_HOOK_PORT=7421
WRANGLR_PWA_PORT=3000

# Where policy, VAPID keys, and push subscriptions are persisted. Defaults
# under ~/.config/wranglr/.
WRANGLR_POLICY_PATH=
WRANGLR_VAPID_PATH=
WRANGLR_PUSH_SUBSCRIPTIONS_PATH=
WRANGLR_VAPID_SUBJECT=mailto:you@example.com

# Path to the Herdr control socket.
WRANGLR_HERDR_SOCKET_PATH=
