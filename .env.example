# Copy relevant values into your shell environment before `bun run start` if
# you need to override a default. Most users can run `bun run start` with
# none of these set — it generates a token, sets up Tailscale Serve, and
# prints a phone URL and QR code.

# Shared secret the PWA must present to the daemon. Auto-generated and persisted
# to ~/.config/wranglr/token on first run if not set.
WRANGLR_TOKEN=

# Set to skip Tailscale entirely and run in plain local-network mode instead:
# the daemon binds to all interfaces and the launcher auto-detects this
# machine's LAN IPv4 address. Same Wi-Fi network only, plain http by default.
WRANGLR_SKIP_TAILSCALE=

# Interface the daemon's WebSocket server binds to. Defaults to 127.0.0.1
# (Tailscale Serve proxies to it) or 0.0.0.0 in skip mode.
WRANGLR_BIND_HOST=

# Interface the static PWA server binds to. Same default/behavior as above.
WRANGLR_PWA_HOST=

# Hostname embedded in the pairing QR code and printed phone URL. Defaults to
# the Tailscale MagicDNS name, or an auto-detected LAN IPv4 address in skip
# mode; set this if auto-detection picks the wrong thing.
WRANGLR_PUBLIC_HOST=

# Set to "true" only in skip mode if you've put the daemon behind your own
# TLS-terminating reverse proxy. Tailscale mode is HTTPS/WSS by default.
WRANGLR_SECURE=

WRANGLR_WS_PORT=7420
WRANGLR_HOOK_PORT=7421
WRANGLR_PWA_PORT=3000

# Where policy, VAPID keys, and push subscriptions are persisted. Defaults
# under ~/.config/wranglr/.
WRANGLR_POLICY_PATH=
WRANGLR_VAPID_PATH=
WRANGLR_PUSH_SUBSCRIPTIONS_PATH=
WRANGLR_VAPID_SUBJECT=mailto:you@example.com

# Path to the Herdr control socket.
WRANGLR_HERDR_SOCKET_PATH=
